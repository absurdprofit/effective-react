{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@absurdprofit/effective-react": ["./packages/effective-react/src/index.ts"]
        },
        "declaration": true,
        "sourceMap": true,
        "target": "ES2022",
        "lib": [
            "ES2022",
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "tsBuildInfoFile": "./.tsbuildinfo",
    },
    "exclude": [
        "node_modules",
        "build"
    ]
}
  