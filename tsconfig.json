{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@absurdprofit/effective-react": [
        "./packages/effective-react/src/index.ts"
      ]
    },
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
  },
  "exclude": [
    "node_modules",
    "build"
  ]
}
